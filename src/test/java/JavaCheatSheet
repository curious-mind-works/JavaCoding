Array declare ways;
-------------------------------------------------------------------------------------------------------------

An array is a collection of elements of the same data type stored in contiguous memory locations.

//Declaration
int arr[]; // Declaration only
int[] arr; // Same as above (recommended)

//Initialize
arr = new int[5];
arr = new int[]{1, 2, 3, 4};

arr = {1, 2, 3}; // Not Allowed Compile Error

int[] arr = {1, 2, 3, 4, 5}; // Declare + initialize
int[] arr = new int[5]; // Create array of size 5 with zeros
int arr[] = new int[]{1, 2, 3}; // Explicit creation with values

// Array of Same data Types -
float[] prices = {10.5f, 20.75f, 30.0f};
double[] marks = {85.5, 90.25, 78.0};
String[] names = {"Ankit", "Rahul", "Amit"};
char[] grades = {'A', 'B', 'C'};

//length
int length = arr.length;

Regular Expressions
-------------------------------------------------------------------------------------------------------------------

String s = "s";

// [] - use for match a single character
System.out.println(s.matches("[s]"));

// single character between range a-z
System.out.println(s.matches("[a-z]"));

// single character can be in range
System.out.println(s.matches("[a-zA-Z0-9]"));

String a = "sanuverma@com";

System.out.println(a.matches("[a-z]{5,}[@]com"));

String b = " ";

System.out.println(b.matches("\\s"));

Collections -
-------------------------------------------------------------------------------------------------------------------

  Map<Integer, String> map = new HashMap<>();
  map.put();
     // 1️ Using entrySet()
        for (Map.Entry<Integer, String> entry : map.entrySet()) {
            System.out.println(entry.getKey() + " = " + entry.getValue());
        }

       // 2️ Using keySet()
        for (Integer key : map.keySet()) {
            System.out.println(key + " = " + map.get(key));
        }

      // 3️ Using values()
        for (String value : map.values()) {
            System.out.println(value);
        }
    }


