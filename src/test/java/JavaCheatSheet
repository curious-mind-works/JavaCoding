## String ##
--------------------------------------------------------------------------------------------------------

# Creation of String -
----------------------------------------------------------------------
String str = "Hello";                     // String Literal
String str2 = new String("World");        // String using new Keyword
----------------------------------------------------------------------

# Length of String 
----------------------------------------------------------------------
int len = str.length(); // number of characters
----------------------------------------------------------------------

# Character Access in String -
----------------------------------------------------------------------
char ch = str.charAt(0); // first character
----------------------------------------------------------------------

# Comparison of Strings - Result will come as true and false
----------------------------------------------------------------------
str.equals("Hello"); // case-sensitive
str.equalsIgnoreCase("hello"); //case-insensitive
str.compareTo("World"); // lexicographical
----------------------------------------------------------------------

# Searching - Result will come as true and false
----------------------------------------------------------------------
str.contains("ell");
str.indexOf("l");
str.lastIndexOf("l");
str.startsWith("He");
str.endsWith("lo");

## Operations on String ##
----------------------------------------------------------------------

# Using Substring -
-------------------
String sub = str.substring(1); // "ello"
String sub2 = str.substring(1, 4); // "ell"

# Using Replace -
----------------
str.replace("l", "x"); // "Hexxo"
str.replaceAll("\s+", "_"); // regex replace spaces

# Using Trim -
--------------
"  Hello  ".trim(); // "Hello"

# Split of String -
-------------------
String[] parts = "a,b,c".split(",");

# String to Char Array -
------------------------
char[] arr = str.toCharArray();

# Using Join -
--------------
String joined = String.join("-", "a", "b", "c"); // "a-b-c"

# Empty & Blank Check -
-----------------------
str.isEmpty();
str.isBlank(); // Java 11+

# Case Conversion -
-------------------
str.toUpperCase();
str.toLowerCase();

